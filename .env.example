PORT=3000

# Resend (https://resend.com) — required for the contact form to send email
RESEND_API_KEY=re_your_api_key_here

# quadlinkbd.com is verified as a sending domain in Resend, so this can send
# directly to CONTACT_TO_EMAIL. If you use a different/unverified domain,
# Resend restricts the sandbox sender (onboarding@resend.dev) to delivering
# only to the email address on your own Resend account.
CONTACT_FROM_EMAIL="Quadlink BD <noreply@quadlinkbd.com>"
CONTACT_TO_EMAIL=info@quadlinkbd.com
